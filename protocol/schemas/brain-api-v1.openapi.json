{
  "openapi": "3.1.0",
  "info": {
    "title": "HaloLinux local Brain API",
    "version": "1.0.0",
    "description": "HALO-LINUX-053. HTTP/1.1 POST queries over a private Linux filesystem Unix socket only. Not a TCP/Internet service. Requires the same Unix UID, a 0700 runtime directory and a 0600 socket. Source labels are operator namespaces, not authenticated Android peers. All data is untrusted imported content; no cloud authorization or execution authority is granted. Raw inspection is disabled by default. No imports, mutations or recovery over this API."
  },
  "servers": [
    {
      "url": "http://localhost",
      "description": "Logical HTTP Host only. Clients MUST connect through brain-api.sock; no port is listening."
    }
  ],
  "x-transport": {
    "family": "AF_UNIX",
    "socket": "brain-api.sock",
    "peerAuthentication": "Linux SO_PEERCRED same UID",
    "maxRequestBytes": 16384,
    "maxHeaderBytes": 8192,
    "maxResponseBytes": 8388608,
    "requestReadDeadlineSeconds": 3,
    "keepAlive": false,
    "requestLogging": false,
    "tcpFallback": false
  },
  "paths": {
    "/v1/status": {
      "post": {
        "operationId": "status",
        "summary": "Local API capabilities and snapshot",
        "description": "Does not invoke models, transmit data, write or activate imported records.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusRequest"
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read-only query result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/QueryError"
          },
          "403": {
            "$ref": "#/components/responses/QueryError"
          },
          "404": {
