          }
        }
      }
    },
    "/v1/records/list": {
      "post": {
        "operationId": "listRecords",
        "summary": "Explicit raw inspection: list selected record IDs",
        "description": "Requires server --allow-inspection and intent=inspect. Not a model-context endpoint.",
        "requestBody": {
          "required": true,
          "content": {
