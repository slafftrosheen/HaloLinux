{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Halo Sync Protocol - Conversation Record",
  "type": "object",
  "required": ["id", "title", "origin_node_id", "created_at", "updated_at", "messages", "revision", "schema_version"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique identifier for this conversation"
    },
    "title": {
      "type": "string",
      "maxLength": 500,
      "description": "Conversation title"
    },
    "origin_node_id": {
      "type": "string",
      "format": "uuid",
      "description": "Node ID where this conversation originated"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp (ISO 8601)"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp (ISO 8601)"
    },
    "provider_id": {
      "type": ["string", "null"],
      "description": "Inference provider used"
    },
    "model_id": {
      "type": ["string", "null"],
      "description": "Model used for this conversation"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "content", "created_at", "revision", "schema_version"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "role": { "type": "string", "enum": ["user", "assistant", "system", "tool"] },
          "content": { "type": "string", "maxLength": 1000000 },
          "provider_id": { "type": ["string", "null"] },
          "model_id": { "type": ["string", "null"] },
          "tokens_used": { "type": ["integer", "null"], "minimum": 0 },
          "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
          "tool_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "arguments"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "arguments": { "type": "object" },
                "result": { "type": ["string", "null"] }
              }
            }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "revision": { "type": "integer", "minimum": 1 },
          "schema_version": { "type": "integer", "minimum": 1 },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "description": "Ordered conversation messages"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Revision number for conflict resolution"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for forward compatibility"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Extensible metadata"
    },
    "tombstone": {
      "type": "boolean",
      "default": false,
      "description": "True if this entry is a deletion marker"
    }
  }
}