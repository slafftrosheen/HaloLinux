{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Halo Sync Protocol - Memory Entry",
  "type": "object",
  "required": ["id", "content", "origin_node_id", "created_at", "revision", "schema_version"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique identifier for this memory entry"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "description": "The memory content text"
    },
    "source": {
      "type": "string",
      "enum": ["user", "assistant", "system", "imported"],
      "description": "Origin of this memory entry"
    },
    "scope": {
      "type": "string",
      "description": "Visibility scope (personal, shared, public, etc.)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score for this memory"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional tags for categorization"
    },
    "origin_node_id": {
      "type": "string",
      "format": "uuid",
      "description": "Node ID where this memory originated"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp (ISO 8601)"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp (ISO 8601)"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Optional expiration timestamp"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Revision number for conflict resolution"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for forward compatibility"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Extensible metadata"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "content_hash", "mime_type", "size"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "mime_type": { "type": "string" },
          "size": { "type": "integer", "minimum": 0 }
        }
      },
      "description": "Content-addressed attachments"
    },
    "tombstone": {
      "type": "boolean",
      "default": false,
      "description": "True if this entry is a deletion marker"
    },
    "conflict_info": {
      "type": ["object", "null"],
      "properties": {
        "conflicting_revision": { "type": "integer" },
        "resolution_strategy": { "type": "string", "enum": ["last_writer_wins", "merge", "manual"] },
        "resolved_at": { "type": "string", "format": "date-time" }
      },
      "description": "Conflict resolution metadata"
    }
  }
}