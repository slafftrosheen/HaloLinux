[Unit]
Description=Halo Linux Node (personal headless runtime)
Documentation=https://github.com/slafftrosheen/HaloLinux
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/halo-node start
WorkingDirectory=%h
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
UMask=0077
RuntimeDirectory=halo-linux
RuntimeDirectoryMode=0700
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
